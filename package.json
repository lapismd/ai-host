{
  "name": "@lapismd/ai-host",
  "private": true,
  "version": "0.0.0",
  "description": "Standalone ACP process host, WebSocket server, and MCP tool bridge for LapisMD consumers",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "lapis-ai-host": "./bin/lapis-ai-host.mjs",
    "lapis-mcp-shim": "./bin/lapis-mcp-shim.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-cli.mjs",
    "check": "pnpm spec:validate && pnpm check:types",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "spec:build": "spec-validator build",
    "spec:check": "spec-validator check",
    "spec:first": "spec-validator first",
    "spec:validate": "spec-validator validate"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "acpx": "^0.13.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@lapismd/spec-validator": "link:../spec-validator",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.4",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8"
  }
}
