{
  "name": "@lapis-notes/ai-host",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "lapis-ai-host": "./bin/lapis-ai-host.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-cli.mjs",
    "check": "pnpm check:types",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    }
  },
  "dependencies": {
    "acpx": "^0.8.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.4",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8"
  }
}
