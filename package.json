{
  "name": "@lapismd/ai-host",
  "version": "0.1.0",
  "description": "Standalone ACP process host, WebSocket server, and MCP tool bridge for LapisMD consumers",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/lapismd/ai-host#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/ai-host.git"
  },
  "bugs": {
    "url": "https://github.com/lapismd/ai-host/issues"
  },
  "files": [
    "bin/",
    "dist/",
    "src/file-tools/NOTICE.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "README.md",
    "spec/src/*.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "bin": {
    "lapis-ai-host": "./bin/lapis-ai-host.mjs",
    "lapis-mcp-shim": "./bin/lapis-mcp-shim.mjs"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/bundle-package.mjs",
    "serve:local": "tsx scripts/serve-local.mjs",
    "check": "pnpm spec:validate && pnpm check:types",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "publint": "pnpm build && publint",
    "checks:release": "pnpm spec:check && pnpm check && pnpm test && pnpm publint",
    "changeset": "changeset",
    "packages:check": "pnpm release:check",
    "packages:pack": "node ./scripts/ai-host-release.mjs pack-check",
    "release:check": "node ./scripts/ai-host-release.mjs check",
    "release:notes": "node ./scripts/ai-host-release.mjs notes",
    "release:plan": "node ./scripts/ai-host-release.mjs plan",
    "release:prepare": "node ./scripts/ai-host-release.mjs prepare",
    "release:publish": "node ./scripts/ai-host-release.mjs publish",
    "release:verify": "node ./scripts/ai-host-release.mjs verify",
    "release:version": "changeset version && pnpm install --lockfile-only && prettier package.json CHANGELOG.md --write",
    "spec:build": "spec-validator build",
    "spec:check": "spec-validator check",
    "spec:first": "spec-validator first",
    "spec:validate": "spec-validator validate"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./file-tools": {
      "types": "./dist/file-tools/index.d.ts",
      "import": "./dist/file-tools/index.js",
      "default": "./dist/file-tools/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "acpx": "^0.13.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@lapismd/spec-validator": "0.1.0",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.4",
    "prettier": "^3.7.4",
    "publint": "^0.3.24",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8"
  }
}
